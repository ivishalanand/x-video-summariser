{
  "manifest_version": 3,
  "name": "X Video Summariser",
  "version": "1.0.0",
  "description": "Summarise X/Twitter videos in a sidebar. Requires local backend on port 47291.",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "http://localhost:47291/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle X Summariser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
