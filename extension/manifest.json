{
  "manifest_version": 3,
  "name": "x video summariser",
  "version": "0.1.0",
  "description": "Summarize twitter/x videos with local whisper + Claude.",
  "permissions": ["sidePanel", "nativeMessaging", "tabs"],
  "host_permissions": ["http://127.0.0.1:8001/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Summarize video" }
}
